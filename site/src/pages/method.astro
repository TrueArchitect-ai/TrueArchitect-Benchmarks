---
import Base from '../layouts/Base.astro'
import { marked } from 'marked'
import { loadReadme } from '../lib/data'
const html = marked.parse(loadReadme(), { gfm: true }) as string
---
<Base title="Method">
  <div class="prose">
  <div class="kicker">Method</div>
  <p class="lede">The repository's README, rendered. It is generated by the export that produced the data, so it can never disagree with the tree it describes.</p>
  <div class="md" set:html={html} />
  </div>
</Base>
