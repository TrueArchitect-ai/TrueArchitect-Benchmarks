---
import Base from '../layouts/Base.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---
<Base title="Not found" description="That page is not in the proof package.">
  <div class="prose">
    <div class="kicker">404</div>
    <h1>Not in the package</h1>
    <p class="lede">That address does not exist on this site. The figures are numbered in the navigation; the runs themselves live in the repository.</p>
    <p><a href={`${base}/`}>Benchmark Results</a> · <a href={`${base}/limitations/`}>Limitations</a> · <a href="https://github.com/TrueArchitect-ai/TrueArchitect-Benchmarks" target="_blank" rel="noopener">Repository ↗</a></p>
  </div>
</Base>
