---
// /results/ moved to the home page; keep the old address working.
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const to = `${base}/`
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Benchmark Results — TrueArchitect Benchmarks</title>
  </head>
  <body><a href={to}>Benchmark Results</a></body>
</html>
