eturn driver, nil\n}\n\nfunc (d *DB) GetDB() *sql.DB {\n\treturn d.db\n}\n\nfunc (d *DB) Close() error {\n\treturn d.db.Close()\n}\n\nfunc (d *DB) IsInitialized(ctx context.Context) (bool, error) {\n\tvar exists bool\n\terr := d.db.QueryRowContext(ctx, \"SELECT EXISTS (SELECT 1 FROM information_schema.tables WHERE table_catalog = current_database() AND table_name = 'memo' AND table_type = 'BASE TABLE')\").Scan(&exists)\n\tif err != nil {\n\t\treturn false, errors.Wrap(err, \"failed to check if database is initialized\")\n\t}\n\treturn exists, nil\n}\n\n// GetDatabaseSize returns the database size in bytes, or -1 if unavailable.\nfunc (d *DB) GetDatabaseSize(ctx context.Context) (int64, error) {\n\tvar size int64\n\tconst q = `SELECT pg_database_size(current_database())`\n\tif err := d.db.QueryRowContext(ctx, q).Scan(&size); err != nil {\n\t\treturn -1, errors.Wrap(err, \"failed to query postgres database size\")\n\t}\n\treturn size, nil\n}\n"},"isEmpty":false,"exceededLimit":false,"totalLines":68,"fileSize":1650,"path":"/bench/repo/store/db/postgres/postgres.go","relatedCursorRulePaths":[],"relatedCursorRules":[],"readRange":{"startLine":1,"endLine":68}}}}}},"hookAdditionalContexts":[],"toolCallId":"toolu_016kAyhGZg7akDMeBtv6d6V9","startedAtMs":"1788277063872","completedAtMs":"1788277064190"}}},{"message":{"case":"assistantMessage","value":{"text":"Perfect! I found the answer. The `DB` struct is defined in the file and implements the PostgreSQL database driver.\n\nq03.\n\n**DB** — store/db/postgres/postgres.go\n\nThe `DB` struct (defined at line 16) implements the database driver for PostgreSQL. It's created by the `NewDB` function which opens a PostgreSQL connection using the \"postgres\" driver string (line 27) and returns a `store.Driver` interface implementation."}}}],"userMessage":{"text":"Answer the SINGLE question below about this repository. Cite file paths. If you cannot determine the answer, say so rather than guessing.\nStart your answer with a line readi