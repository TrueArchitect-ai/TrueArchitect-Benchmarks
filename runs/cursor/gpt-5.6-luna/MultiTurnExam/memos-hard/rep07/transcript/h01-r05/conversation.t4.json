schema.tables WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'memo' AND TABLE_TYPE = 'BASE TABLE')\").Scan(&exists)\n54:\tif err != nil {\n55:\t\treturn false, errors.Wrap(err, \"failed to check if database is initialized\")\n56:\t}\n57:\treturn exists, nil\n58:}\n59:\n60:// GetDatabaseSize returns the database size in bytes, or -1 if unavailable.\n61:func (d *DB) GetDatabaseSize(ctx context.Context) (int64, error) {\n62:\tvar size int64\n63:\tconst q = `SELECT COALESCE(SUM(data_length + index_length), 0)\n64:\t           FROM information_schema.tables\n65:\t           WHERE table_schema = DATABASE()`\n66:\tif err := d.db.QueryRowContext(ctx, q).Scan(&size); err != nil {\n67:\t\treturn -1, errors.Wrap(err, \"failed to query mysql database size\")\n68:\t}\n69:\treturn size, nil\n70:}\n71:\n72:func mergeDSN(baseDSN string) (string, error) {\n73:\tconfig, err := mysql.ParseDSN(baseDSN)\n74:\tif err != nil {\n75:\t\treturn \"\", errors.Wrapf(err, \"failed to parse DSN: %s\", baseDSN)\n76:\t}\n77:\n78:\tconfig.MultiStatements = true\n79:\treturn config.FormatDSN(), nil\n80:}\n1:package test\n2:\n3:import (\n4:\t\"context\"\n5:\t\"database/sql\"\n6:\t\"fmt\"\n7:\t\"net\"\n8:\t\"net/url\"\n9:\t\"os\"\n10:\t\"strings\"\n11:\t\"sync\"\n12:\t\"sync/atomic\"\n13:\t\"testing\"\n14:\t\"time\"\n15:\n16:\tmysqldriver \"github.com/go-sql-driver/mysql\"\n17:\t\"github.com/moby/moby/api/types/container\"\n18:\t\"github.com/pkg/errors\"\n19:\t\"github.com/testcontainers/testcontainers-go\"\n20:\t\"github.com/testcontainers/testcontainers-go/modules/mysql\"\n21:\t\"github.com/testcontainers/testcontainers-go/modules/postgres\"\n22:\t\"github.com/testcontainers/testcontainers-go/network\"\n23:\t\"github.com/testcontainers/testcontainers-go/wait\"\n24:\n25:\t// Database drivers for connection verification.\n26:\t_ \"github.com/lib/pq\"\n27:)\n28:\n29:const (\n30:\ttestUser     = \"root\"\n31:\ttestPassword = \"test\"\n32:\n33:\t// Memos container settings for migration testing.\n34:\tM